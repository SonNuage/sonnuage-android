<?xml version="1.0" encoding="utf-8"?>
<!-- Localify.UI et Localify.Contracts viennent du registre NuGet du projet pmj.bailly/localify (privé) :
     la CI s'y connecte avec son jeton de job ; en local, cloner localify à côté de ce dépôt suffit
     (ses sources sont utilisées à la place du paquet, voir Directory.Build.props). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="localify" value="https://git.pmjb.org/api/v4/projects/7/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="localify">
      <package pattern="Localify.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
