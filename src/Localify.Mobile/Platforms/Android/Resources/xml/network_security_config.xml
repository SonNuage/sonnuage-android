<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP en clair autorisé pour un serveur sur le réseau local (ex. http://192.168.1.10:8080).
     Derrière Cloudflare tout passe en HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
