<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>SonNuage.Mobile</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>SonNuage</ApplicationTitle>
    <ApplicationId>org.pmjb.sonnuage</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Surchargé par la CI (-p:ApplicationVersion=$CI_PIPELINE_IID) : doit croître à chaque build installé. -->
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Téléphones 64 bits ARM seulement : un build et un APK bien plus légers que les quatre architectures par
         défaut. Pour un émulateur x86_64, ajouter android-x64. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- Les DTO sont (dé)sérialisés par réflexion : on ne rogne que le framework. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- Hors de Visual Studio, un APK Debug doit aussi tourner seul : sans les assemblies embarquées (Fast Deployment),
       il s'arrête au lancement (« No assemblies found in .../.__override__ »). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(BuildingInsideVisualStudio)' != 'true'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.62" Color="#141a33" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141a33" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" />
    <PackageReference Include="Xamarin.AndroidX.Media3.DataSource" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Common" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
  </ItemGroup>

  <!-- SDK Glyph Matrix de Nothing (matrice du Phone 3). Sa licence interdit de le redistribuer : il n'est pas dans le
       dépôt mais téléchargé au build depuis le dépôt officiel, à une version figée et vérifiée par sha256. -->
  <PropertyGroup>
    <GlyphSdkUrl>https://raw.githubusercontent.com/Nothing-Developer-Programme/GlyphMatrix-Developer-Kit/999b1143a6bff0dd79db11d21b92c15c56a346b1/glyph-matrix-sdk-2.0.aar</GlyphSdkUrl>
    <GlyphSdkSha256>be00ee9cd7115f6b11984c6e31fe98e298fb726940d1555063610685ef3bbf29</GlyphSdkSha256>
    <GlyphSdkDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)glyph\</GlyphSdkDir>
    <GlyphSdkAar>$(GlyphSdkDir)glyph-matrix-sdk-2.0.aar</GlyphSdkAar>
  </PropertyGroup>
  <ItemGroup>
    <AndroidLibrary Include="$(GlyphSdkAar)" />
  </ItemGroup>
  <Target Name="DownloadGlyphSdk" BeforeTargets="BeforeBuild;PrepareForBuild" Condition="!Exists('$(GlyphSdkAar)')">
    <DownloadFile SourceUrl="$(GlyphSdkUrl)" DestinationFolder="$(GlyphSdkDir)" DestinationFileName="glyph-matrix-sdk-2.0.aar.part" Retries="3" />
    <GetFileHash Files="$(GlyphSdkAar).part" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_GlyphSdkHash" />
    </GetFileHash>
    <Error Condition="'$(_GlyphSdkHash)' != '$(GlyphSdkSha256)'" Text="SDK Glyph Matrix : sha256 $(_GlyphSdkHash) au lieu de $(GlyphSdkSha256)." />
    <Move SourceFiles="$(GlyphSdkAar).part" DestinationFiles="$(GlyphSdkAar)" />
  </Target>

  <!-- Pages et composants partagés avec le client web : sources du dépôt sonnuage s'il est cloné à côté (développement),
       sinon paquet NuGet publié par sa CI (version dans Directory.Packages.props). -->
  <ItemGroup Condition="Exists('$(SonNuageUiProject)')">
    <ProjectReference Include="$(SonNuageUiProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(SonNuageUiProject)')">
    <PackageReference Include="SonNuage.UI" />
  </ItemGroup>

</Project>
