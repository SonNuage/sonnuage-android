<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>SonNuage.Mobile</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>SonNuage</ApplicationTitle>
    <ApplicationId>org.pmjb.sonnuage</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Surchargé par la CI (-p:ApplicationVersion=$CI_PIPELINE_IID) : doit croître à chaque build installé. -->
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Les DTO sont (dé)sérialisés par réflexion : on ne rogne que le framework. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- Hors de Visual Studio, un APK Debug doit aussi tourner seul : sans les assemblies embarquées (Fast Deployment),
       il s'arrête au lancement (« No assemblies found in .../.__override__ »). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(BuildingInsideVisualStudio)' != 'true'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.62" Color="#141a33" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141a33" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" />
    <PackageReference Include="Xamarin.AndroidX.Media3.DataSource" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Common" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
  </ItemGroup>

  <!-- Pages et composants partagés avec le client web : sources du dépôt sonnuage s'il est cloné à côté (développement),
       sinon paquet NuGet publié par sa CI (version dans Directory.Packages.props). -->
  <ItemGroup Condition="Exists('$(SonNuageUiProject)')">
    <ProjectReference Include="$(SonNuageUiProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(SonNuageUiProject)')">
    <PackageReference Include="SonNuage.UI" />
  </ItemGroup>

</Project>
